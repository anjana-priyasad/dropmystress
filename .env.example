# Copy to .env.local and fill in ONE of the keys below.
# With no key set, the app still works and shows curated fallback messages.

# Optional: force a provider ("openai" | "gemini"). Otherwise the first key found wins.
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voice guide: with OPENAI_API_KEY set, spoken guidance uses natural AI voices.
# Without it, the browser's built-in voice is used instead.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# SEO. The public URL of the site (used for canonical URLs, sitemap and social cards).
# On Cloudflare, add these as *build* variables so they're available during `pnpm run build`.
NEXT_PUBLIC_SITE_URL=https://dropmystress.com
# Optional: search console verification tokens (just the content value).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
